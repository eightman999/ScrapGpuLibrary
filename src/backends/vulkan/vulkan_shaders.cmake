# Compile the compute shaders of the Vulkan backend (.comp) to SPIR-V with glslc and embed them
# as uint32 arrays in an autogenerated header. glslc runs at configure time (the build machine may
# not have it and the generated header must exist either way); cmake re-runs when a .comp changes.
# When glslc is missing the backend still builds: the table has NULL entries and op_supported
# reports "shaders not built".

# name|file|glslc -D definitions (order must match enum vk_shader_id in vk.h)
set(SG_VULKAN_SHADER_LIST
    "add|binary.comp|-DBINARY_OP_ADD"
    "mul|binary.comp|-DBINARY_OP_MUL"
    "rms_norm|rms_norm.comp|"
    "mv_f32|mul_mat_vec.comp|-DDATA_A_F32"
    "mv_f16|mul_mat_vec.comp|-DDATA_A_F16"
    "mv_q4_0|mul_mat_vec.comp|-DDATA_A_Q4_0"
    "mv_q8_0|mul_mat_vec.comp|-DDATA_A_Q8_0"
    "mm_f32|mul_mat.comp|-DDATA_A_F32"
    "mm_f16|mul_mat.comp|-DDATA_A_F16"
    "mm_q4_0|mul_mat.comp|-DDATA_A_Q4_0"
    "mm_q8_0|mul_mat.comp|-DDATA_A_Q8_0"
)

# spv_file -> "0x........, 0x........, ..." (SPIR-V words are little-endian in the file)
function(scrapgpu_vk_spv_hex spv_file out_var)
    file(READ "${spv_file}" HEX_CONTENT HEX)
    string(REGEX MATCHALL ".." BYTES "${HEX_CONTENT}")
    list(LENGTH BYTES NBYTES)
    set(HEX_WORDS "")
    math(EXPR FULL_WORDS "${NBYTES} / 4")
    math(EXPR LAST "${FULL_WORDS} - 1")
    if (LAST LESS 0)
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    foreach (W RANGE 0 ${LAST})
        math(EXPR I "${W} * 4")
        list(GET BYTES ${I} B0)
        math(EXPR I "${W} * 4 + 1")
        list(GET BYTES ${I} B1)
        math(EXPR I "${W} * 4 + 2")
        list(GET BYTES ${I} B2)
        math(EXPR I "${W} * 4 + 3")
        list(GET BYTES ${I} B3)
        set(HEX_WORDS "${HEX_WORDS}0x${B3}${B2}${B1}${B0}, ")
    endforeach()
    set(${out_var} "${HEX_WORDS}" PARENT_SCOPE)
endfunction()

function(scrapgpu_vulkan_embed_shaders target vulkan_dir output_dir)
    find_program(SG_GLSLC NAMES glslc HINTS ENV VULKAN_SDK PATH_SUFFIXES bin)
    file(MAKE_DIRECTORY "${output_dir}/shaders")

    set(HDR "${output_dir}/autogenerated/vk-shaders.h")
    set(CONTENT "// generated by CMake from vulkan/shaders/*.comp, do not edit\n")
    string(APPEND CONTENT "#ifndef SCRAPGPU_VULKAN_SHADERS_H\n#define SCRAPGPU_VULKAN_SHADERS_H\n\n")
    string(APPEND CONTENT "#include <stddef.h>\n#include <stdint.h>\n\n")
    string(APPEND CONTENT "struct sg_vk_shader {\n    const char * name;\n    const uint32_t * code;\n    size_t size;\n};\n\n")

    if (SG_GLSLC)
        set(SG_BUILT 1)
    else ()
        set(SG_BUILT 0)
    endif()
    set(SG_BODIES "")
    set(SG_TABLE "")
    foreach (SG_ENTRY ${SG_VULKAN_SHADER_LIST})
        string(REPLACE "|" ";" SG_PARTS "${SG_ENTRY}")
        list(GET SG_PARTS 0 SG_NAME)
        list(GET SG_PARTS 1 SG_FILE)
        list(GET SG_PARTS 2 SG_DEFS)
        set(SG_SRC "${vulkan_dir}/shaders/${SG_FILE}")
        set(SG_SPV "${output_dir}/shaders/${SG_NAME}.spv")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SG_SRC}")
        if (SG_BUILT AND SG_GLSLC)
            separate_arguments(SG_DEF_LIST UNIX_COMMAND "${SG_DEFS}")
            execute_process(
                COMMAND "${SG_GLSLC}" -fshader-stage=compute -O ${SG_DEF_LIST} "${SG_SRC}" -o "${SG_SPV}"
                RESULT_VARIABLE SG_RES
                OUTPUT_VARIABLE SG_OUT
                ERROR_VARIABLE SG_ERR)
            if (NOT SG_RES EQUAL 0)
                message(WARNING "glslc failed for ${SG_FILE} ${SG_DEFS}: ${SG_ERR}")
                set(SG_BUILT 0)
            else ()
                scrapgpu_vk_spv_hex("${SG_SPV}" SG_HEX)
                string(APPEND SG_BODIES "static const uint32_t sg_vk_spv_${SG_NAME}[] = { ${SG_HEX}};\n")
            endif()
        endif()
        string(APPEND SG_TABLE "    { \"${SG_NAME}\", sg_vk_spv_${SG_NAME}, sizeof(sg_vk_spv_${SG_NAME}) },\n")
    endforeach()

    if (NOT SG_BUILT)
        set(SG_TABLE "")
        set(SG_BODIES "")
        foreach (SG_ENTRY ${SG_VULKAN_SHADER_LIST})
            string(REPLACE "|" ";" SG_PARTS "${SG_ENTRY}")
            list(GET SG_PARTS 0 SG_NAME)
            string(APPEND SG_TABLE "    { \"${SG_NAME}\", NULL, 0 },\n")
        endforeach()
    endif()

    if (SG_BUILT)
        string(APPEND CONTENT "#define SG_VK_SHADERS_BUILT 1\n\n")
    else ()
        string(APPEND CONTENT "#define SG_VK_SHADERS_BUILT 0\n\n")
    endif()
    string(APPEND CONTENT "${SG_BODIES}\n")
    string(APPEND CONTENT "static const sg_vk_shader sg_vk_shader_table[] = {\n${SG_TABLE}};\n\n")
    string(APPEND CONTENT "#endif\n")

    set(SG_OLD "")
    if (EXISTS "${HDR}")
        file(READ "${HDR}" SG_OLD)
    endif()
    if (NOT "${SG_OLD}" STREQUAL "${CONTENT}")
        file(WRITE "${HDR}" "${CONTENT}")
    endif()
    target_include_directories(${target} PRIVATE "${output_dir}/autogenerated")
endfunction()
