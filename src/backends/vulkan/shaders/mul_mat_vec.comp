#version 450

// MUL_MAT with a single-column src1 (mat-vec): one workgroup per output row, threads stride the
// inner dim, shared-memory reduction. src0 is F32 / F16 / Q4_0 / Q8_0 in the natural GGUF block
// layout (-DDATA_A_*); src1 and dst are F32.
// Ported from ggml-vulkan (MIT License, Copyright (c) 2023-2026 The ggml authors), see THIRD_PARTY_NOTICES.md
// (mul_mat_vec_base.glsl: workgroup-per-row reduction; dequant_funcs.glsl: the Q4_0/Q8_0
// dequantize4 code; types.glsl: the packed block layouts).

#if defined(DATA_A_F16) || defined(DATA_A_Q4_0) || defined(DATA_A_Q8_0)
#extension GL_EXT_shader_16bit_storage : require
#endif

#define BLOCK 128
layout(local_size_x = BLOCK, local_size_y = 1, local_size_z = 1) in;

#if defined(DATA_A_F32)
layout(binding = 0) readonly buffer A { float data_a[]; };      // elements
#else
layout(binding = 0) readonly buffer A16 { uint16_t data_a[]; }; // 16-bit units
#endif
layout(binding = 1) readonly buffer B { float data_b[]; };
layout(binding = 2) writeonly buffer D { float data_d[]; };

// a_* in storage units (floats for F32, uint16 otherwise), b_* and d_* in floats
layout(push_constant) uniform Params {
    uint ncols;                           // K elements (a multiple of the block size for quant)
    uint a_off, a_nb1, a_nb2, a_nb3;      // src0 base + row/batch strides
    uint b_off, b_nb2, b_nb3;             // src1 base + batch strides (ne1 == 1)
    uint d_off, d_nb2, d_nb3;             // dst base + batch strides (ne1 == 1)
    uint r2, r3;                          // broadcast factors src1.ne[23] / src0.ne[23]
    uint ne12;                            // src1.ne[2]: the flat batch index = i13*ne12 + i12
    uint nrows;                           // src0.ne[1]: bounds the flat row index (must stay in
                                          // sync with pc_mv in api.cpp)
} p;

shared float sumsh[BLOCK];

#if !defined(DATA_A_F32)
// the 16-bit storage extension allows uint16_t only in buffers: convert at the load
float f16_to_f32(uint v) { return unpackHalf2x16(v).x; }
#endif
#if defined(DATA_A_Q8_0)
float s8(uint v) { return float(int(v ^ 0x80u) - 128); }
#endif

void main() {
    const uint row = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    // the dispatch is padded (gx is capped at 65535 and gy covers the rest): workgroups past the
    // last row must not touch the tensor. The guard is uniform per workgroup — row depends on the
    // workgroup ids only — so a whole workgroup returns together and no partial workgroup skips
    // the barrier() inside reduce_result.
    if (row >= p.nrows) {
        return;
    }
    const uint batch = gl_WorkGroupID.z;
    const uint tid = gl_LocalInvocationID.x;
    const uint i12 = batch % p.ne12;
    const uint i13 = batch / p.ne12;
    const uint i02 = i12 / p.r2;
    const uint i03 = i13 / p.r3;
    const uint a_row = p.a_off + row * p.a_nb1 + i02 * p.a_nb2 + i03 * p.a_nb3;
    const uint b_base = p.b_off + i12 * p.b_nb2 + i13 * p.b_nb3;

    float acc = 0.0f;

#if defined(DATA_A_F32)
    for (uint k = tid; k < p.ncols; k += BLOCK) {
        acc += data_a[a_row + k] * data_b[b_base + k];
    }
#elif defined(DATA_A_F16)
    for (uint k = tid; k < p.ncols; k += BLOCK) {
        acc += f16_to_f32(uint(data_a[a_row + k])) * data_b[b_base + k];
    }
#elif defined(DATA_A_Q4_0)
    // 18-byte blocks {f16 d, 16 nibble bytes}: thread t covers elements {e..e+3} and {e+16..e+19}
    // of each 32-value block, e = 4*(t&3); dequantize4 is the ggml-vulkan Q4_0 unpacking.
    for (uint col = tid * 8u; col < p.ncols; col += BLOCK * 8u) {
        const uint ib  = a_row + (col >> 5) * 9u;
        const uint iqs = (col & 31u) >> 1;
        const uint kb  = col & ~31u;
        const uint v0  = uint(data_a[ib + 1u + (iqs >> 1)]);
        const uint v1  = uint(data_a[ib + 1u + ((iqs + 2u) >> 1)]);
        const float d  = f16_to_f32(uint(data_a[ib]));
        const vec4 a0 = (vec4(v0 & 0xFu, (v0 >> 4) & 0xFu, (v0 >> 8) & 0xFu, v0 >> 12) - 8.0f) * d;
        const vec4 a1 = (vec4(v1 & 0xFu, (v1 >> 4) & 0xFu, (v1 >> 8) & 0xFu, v1 >> 12) - 8.0f) * d;
        const vec4 b0 = vec4(data_b[b_base + kb + iqs],      data_b[b_base + kb + iqs + 16u],
                             data_b[b_base + kb + iqs + 1u], data_b[b_base + kb + iqs + 17u]);
        const vec4 b1 = vec4(data_b[b_base + kb + iqs + 2u], data_b[b_base + kb + iqs + 18u],
                             data_b[b_base + kb + iqs + 3u], data_b[b_base + kb + iqs + 19u]);
        acc += dot(a0, b0) + dot(a1, b1);
    }
#elif defined(DATA_A_Q8_0)
    // 34-byte blocks {f16 d, 32 int8}: thread t covers elements {8(t&3)..8(t&3)+7} of each block.
    for (uint col = tid * 8u; col < p.ncols; col += BLOCK * 8u) {
        const uint ib  = a_row + (col >> 5) * 17u;
        const uint iqs = col & 31u;
        const uint kb  = col & ~31u;
        const uint w0  = uint(data_a[ib + 1u + (iqs >> 1)]);
        const uint w1  = uint(data_a[ib + 1u + (iqs >> 1) + 1u]);
        const uint w2  = uint(data_a[ib + 1u + (iqs >> 1) + 2u]);
        const uint w3  = uint(data_a[ib + 1u + (iqs >> 1) + 3u]);
        const float d  = f16_to_f32(uint(data_a[ib]));
        const vec4 a0 = vec4(s8(w0 & 0xFFu), s8(w0 >> 8), s8(w1 & 0xFFu), s8(w1 >> 8)) * d;
        const vec4 a1 = vec4(s8(w2 & 0xFFu), s8(w2 >> 8), s8(w3 & 0xFFu), s8(w3 >> 8)) * d;
        const vec4 b0 = vec4(data_b[b_base + kb + iqs],      data_b[b_base + kb + iqs + 1u],
                             data_b[b_base + kb + iqs + 2u], data_b[b_base + kb + iqs + 3u]);
        const vec4 b1 = vec4(data_b[b_base + kb + iqs + 4u], data_b[b_base + kb + iqs + 5u],
                             data_b[b_base + kb + iqs + 6u], data_b[b_base + kb + iqs + 7u]);
        acc += dot(a0, b0) + dot(a1, b1);
    }
#endif

    sumsh[tid] = acc;
    barrier();
    for (uint s = BLOCK / 2; s > 0; s >>= 1) {
        if (tid < s) {
            sumsh[tid] += sumsh[tid + s];
        }
        barrier();
    }
    if (tid == 0) {
        data_d[p.d_off + row + i12 * p.d_nb2 + i13 * p.d_nb3] = sumsh[0];
    }
}
